# Local development settings (production values come from AWS Parameter Store).
FLASK_CONFIG=dev
SECRET_KEY=change-me

# MySQL
AWS_motivetag_DB=127.0.0.1
DB_USER=root
DB_PASSWORD=testpw
DB_DATABASE=motivetag

# S3 bucket for uploaded images; leave empty locally to disable images
IMAGE_BUCKET=
AWS_REGION=ap-east-2

# Optional comma-separated extra origins allowed to open the chat socket
SOCKETIO_CORS_ORIGINS=

# Optional Sentry DSN; unset disables error reporting
SENTRY_DSN=
